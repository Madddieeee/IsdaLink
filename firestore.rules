rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function supplierPath(uid) {
      return /databases/$(database)/documents/supplierProfiles/$(uid);
    }

    function stockPath(stockId) {
      return /databases/$(database)/documents/fishStocks/$(stockId);
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function reviewPath(orderId) {
      return /databases/$(database)/documents/reviews/$(orderId);
    }

    function changeRequestPath(supplierId) {
      return /databases/$(database)/documents/supplierChangeRequests/$(supplierId);
    }

    function currentUserData() {
      return get(userPath(currentUid())).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(currentUid()))
        && currentUserData().get('role', '') == 'admin';
    }

    function isApprovedSupplierAccount(uid) {
      return signedIn()
        && currentUid() == uid
        && exists(userPath(uid))
        && get(userPath(uid)).data.get('role', '') == 'supplier'
        && get(userPath(uid)).data.get('supplierStatus', '') == 'approved';
    }

    function changedOnly(fields) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(fields);
    }

    function isCompletedOrder(data) {
      return data.get('orderStatus', '') == 'Delivered'
        || data.get('orderStatus', '') == 'Completed'
        || data.get('orderStatus', '') == 'delivered'
        || data.get('orderStatus', '') == 'completed';
    }

    function isPublicApprovedSupplier(data) {
      return signedIn() && data.get('status', '') == 'approved';
    }

    function notificationOwnedByCurrentUser(data) {
      return signedIn() && (
        data.get('userId', '') == currentUid()
        || data.get('vendorId', '') == currentUid()
        || data.get('supplierId', '') == currentUid()
      );
    }

    function hasNoServerPushFields(data) {
      return !data.keys().hasAny([
        'pushEventId',
        'pushStatus',
        'pushStartedAt',
        'pushedAt',
        'pushSuccessCount',
        'pushFailureCount'
      ]);
    }

    function locationInBounds(
      latitude,
      longitude,
      south,
      west,
      north,
      east
    ) {
      return latitude >= south
        && latitude <= north
        && longitude >= west
        && longitude <= east;
    }

    function validAgusanDelNortePin(latitude, longitude, city) {
      return (city == 'Buenavista'
          && locationInBounds(
            latitude, longitude, 8.751580, 125.230037, 8.991506, 125.509430
          )
        )
        || (city == 'Butuan City'
          && locationInBounds(
            latitude, longitude, 8.740690, 125.455216, 9.056310, 125.743619
          )
        )
        || (city == 'Carmen'
          && locationInBounds(
            latitude, longitude, 8.854489, 125.213400, 9.028491, 125.312384
          )
        )
        || (city == 'City of Cabadbaran'
          && locationInBounds(
            latitude, longitude, 9.057913, 125.512221, 9.230395, 125.775509
          )
        )
        || (city == 'Jabonga'
          && locationInBounds(
            latitude, longitude, 9.285986, 125.445348, 9.462061, 125.753410
          )
        )
        || (city == 'Kitcharao'
          && locationInBounds(
            latitude, longitude, 9.369201, 125.547441, 9.470886, 125.752423
          )
        )
        || (city == 'Las Nieves'
          && locationInBounds(
            latitude, longitude, 8.690628, 125.230037, 8.768590, 125.677411
          )
        )
        || (city == 'Magallanes'
          && locationInBounds(
            latitude, longitude, 9.026259, 125.525767, 9.073992, 125.579208
          )
        )
        || (city == 'Nasipit'
          && locationInBounds(
            latitude, longitude, 8.854489, 125.275885, 8.999486, 125.398590
          )
        )
        || (city == 'Remedios T. Romualdez'
          && locationInBounds(
            latitude, longitude, 9.026259, 125.551145, 9.094860, 125.757086
          )
        )
        || (city == 'Santiago'
          && locationInBounds(
            latitude, longitude, 9.208370, 125.516002, 9.315524, 125.766331
          )
        )
        || (city == 'Tubay'
          && locationInBounds(
            latitude, longitude, 9.131576, 125.488375, 9.320970, 125.634949
          )
        );
    }

    function validAgusanDelSurPin(latitude, longitude, city) {
      return (city == 'Bunawan'
          && locationInBounds(
            latitude, longitude, 8.101518, 125.886409, 8.275236, 126.189982
          )
        )
        || (city == 'City of Bayugan'
          && locationInBounds(
            latitude, longitude, 8.600227, 125.657239, 8.895713, 125.940096
          )
        )
        || (city == 'Esperanza'
          && locationInBounds(
            latitude, longitude, 8.470070, 125.239561, 8.748743, 125.804581
          )
        )
        || (city == 'La Paz'
          && locationInBounds(
            latitude, longitude, 8.156342, 125.300693, 8.362269, 125.902409
          )
        )
        || (city == 'Loreto'
          && locationInBounds(
            latitude, longitude, 7.943381, 125.371389, 8.275236, 125.913692
          )
        )
        || (city == 'Prosperidad'
          && locationInBounds(
            latitude, longitude, 8.495595, 125.787541, 8.841130, 126.008246
          )
        )
        || (city == 'Rosario'
          && locationInBounds(
            latitude, longitude, 8.255369, 125.880722, 8.455829, 126.177178
          )
        )
        || (city == 'San Francisco'
          && locationInBounds(
            latitude, longitude, 8.330962, 125.845837, 8.607765, 126.063090
          )
        )
        || (city == 'San Luis'
          && locationInBounds(
            latitude, longitude, 8.303562, 125.239561, 8.623169, 125.819575
          )
        )
        || (city == 'Santa Josefa'
          && locationInBounds(
            latitude, longitude, 7.944304, 125.955055, 8.117518, 126.073375
          )
        )
        || (city == 'Sibagat'
          && locationInBounds(
            latitude, longitude, 8.744793, 125.657239, 9.171620, 125.903900
          )
        )
        || (city == 'Talacogon'
          && locationInBounds(
            latitude, longitude, 8.312260, 125.536585, 8.546719, 125.915613
          )
        )
        || (city == 'Trento'
          && locationInBounds(
            latitude, longitude, 7.944304, 125.976416, 8.196573, 126.265053
          )
        )
        || (city == 'Veruela'
          && locationInBounds(
            latitude, longitude, 7.943381, 125.769268, 8.131063, 125.992416
          )
        );
    }

    function validDinagatIslandsPin(latitude, longitude, city) {
      return (city == 'Basilisa'
          && locationInBounds(
            latitude, longitude, 9.981560, 125.468710, 10.165739, 125.627455
          )
        )
        || (city == 'Cagdianao'
          && locationInBounds(
            latitude, longitude, 9.844500, 125.603437, 10.194983, 125.714772
          )
        )
        || (city == 'Dinagat'
          && locationInBounds(
            latitude, longitude, 9.931606, 125.526712, 10.005629, 125.646196
          )
        )
        || (city == 'Libjo'
          && locationInBounds(
            latitude, longitude, 10.112733, 125.482835, 10.285352, 125.669892
          )
        )
        || (city == 'Loreto'
          && locationInBounds(
            latitude, longitude, 10.238929, 125.455340, 10.479595, 125.689633
          )
        )
        || (city == 'San Jose'
          && locationInBounds(
            latitude, longitude, 9.988351, 125.560625, 10.058334, 125.645513
          )
        )
        || (city == 'Tubajon'
          && locationInBounds(
            latitude, longitude, 10.200037, 125.505872, 10.356805, 125.664870
          )
        );
    }

    function validSurigaoDelNortePin(latitude, longitude, city) {
      return (city == 'Alegria'
          && locationInBounds(
            latitude, longitude, 9.421680, 125.543009, 9.548939, 125.708172
          )
        )
        || (city == 'Bacuag'
          && locationInBounds(
            latitude, longitude, 9.497800, 125.581172, 9.628302, 125.693173
          )
        )
        || (city == 'Burgos'
          && locationInBounds(
            latitude, longitude, 9.961719, 126.049294, 10.048595, 126.105061
          )
        )
        || (city == 'City of Surigao'
          && locationInBounds(
            latitude, longitude, 9.657185, 125.418133, 9.925173, 125.740596
          )
        )
        || (city == 'Claver'
          && locationInBounds(
            latitude, longitude, 9.318040, 125.690865, 9.593277, 125.891799
          )
        )
        || (city == 'Dapa'
          && locationInBounds(
            latitude, longitude, 9.679377, 125.957999, 9.808324, 126.125450
          )
        )
        || (city == 'Del Carmen'
          && locationInBounds(
            latitude, longitude, 9.772423, 125.884029, 9.926761, 126.060770
          )
        )
        || (city == 'General Luna'
          && locationInBounds(
            latitude, longitude, 9.749418, 126.084340, 9.852773, 126.174928
          )
        )
        || (city == 'Gigaquit'
          && locationInBounds(
            latitude, longitude, 9.397130, 125.626789, 9.609682, 125.740698
          )
        )
        || (city == 'Mainit'
          && locationInBounds(
            latitude, longitude, 9.439851, 125.442027, 9.625960, 125.614401
          )
        )
        || (city == 'Malimono'
          && locationInBounds(
            latitude, longitude, 9.431441, 125.383695, 9.666498, 125.480637
          )
        )
        || (city == 'Pilar'
          && locationInBounds(
            latitude, longitude, 9.791856, 126.041906, 9.928616, 126.128616
          )
        )
        || (city == 'Placer'
          && locationInBounds(
            latitude, longitude, 9.585080, 125.525795, 9.714639, 125.668473
          )
        )
        || (city == 'San Benito'
          && locationInBounds(
            latitude, longitude, 9.899551, 125.930375, 9.992812, 126.056001
          )
        )
        || (city == 'San Francisco'
          && locationInBounds(
            latitude, longitude, 9.649145, 125.383695, 9.793454, 125.445936
          )
        )
        || (city == 'San Isidro'
          && locationInBounds(
            latitude, longitude, 9.882530, 126.021775, 9.979439, 126.122232
          )
        )
        || (city == 'Santa Monica'
          && locationInBounds(
            latitude, longitude, 9.962424, 126.017228, 10.070544, 126.079460
          )
        )
        || (city == 'Sison'
          && locationInBounds(
            latitude, longitude, 9.605250, 125.428050, 9.705444, 125.548527
          )
        )
        || (city == 'Socorro'
          && locationInBounds(
            latitude, longitude, 9.552243, 125.888850, 9.768417, 125.998319
          )
        )
        || (city == 'Tagana-an'
          && locationInBounds(
            latitude, longitude, 9.641405, 125.525369, 9.773575, 125.713209
          )
        )
        || (city == 'Tubod'
          && locationInBounds(
            latitude, longitude, 9.532918, 125.527047, 9.614970, 125.612500
          )
        );
    }

    function validSurigaoDelSurPin(latitude, longitude, city) {
      return (city == 'Barobo'
          && locationInBounds(
            latitude, longitude, 8.436658, 125.992117, 8.607765, 126.362020
          )
        )
        || (city == 'Bayabas'
          && locationInBounds(
            latitude, longitude, 8.888563, 126.208085, 9.023458, 126.316829
          )
        )
        || (city == 'Cagwait'
          && locationInBounds(
            latitude, longitude, 8.839071, 126.208864, 8.957070, 126.336770
          )
        )
        || (city == 'Cantilan'
          && locationInBounds(
            latitude, longitude, 9.230570, 125.735439, 9.407343, 126.014754
          )
        )
        || (city == 'Carmen'
          && locationInBounds(
            latitude, longitude, 9.085480, 125.767498, 9.254041, 126.032011
          )
        )
        || (city == 'Carrascal'
          && locationInBounds(
            latitude, longitude, 9.297530, 125.735439, 9.504016, 125.996708
          )
        )
        || (city == 'City of Bislig'
          && locationInBounds(
            latitude, longitude, 8.050979, 126.146967, 8.309547, 126.457228
          )
        )
        || (city == 'City of Tandag'
          && locationInBounds(
            latitude, longitude, 8.982375, 126.046569, 9.154480, 126.227614
          )
        )
        || (city == 'Cortes'
          && locationInBounds(
            latitude, longitude, 9.132936, 126.064749, 9.317303, 126.211016
          )
        )
        || (city == 'Hinatuan'
          && locationInBounds(
            latitude, longitude, 8.236580, 126.157051, 8.555111, 126.396251
          )
        )
        || (city == 'Lanuza'
          && locationInBounds(
            latitude, longitude, 9.073232, 125.858155, 9.291991, 126.166348
          )
        )
        || (city == 'Lianga'
          && locationInBounds(
            latitude, longitude, 8.555767, 125.962289, 8.801478, 126.188722
          )
        )
        || (city == 'Lingig'
          && locationInBounds(
            latitude, longitude, 7.925008, 126.219791, 8.250712, 126.459292
          )
        )
        || (city == 'Madrid'
          && locationInBounds(
            latitude, longitude, 9.181577, 125.747234, 9.294737, 126.029396
          )
        )
        || (city == 'Marihatag'
          && locationInBounds(
            latitude, longitude, 8.759944, 126.080150, 8.876779, 126.342148
          )
        )
        || (city == 'San Agustin'
          && locationInBounds(
            latitude, longitude, 8.683465, 126.133132, 8.810095, 126.258442
          )
        )
        || (city == 'San Miguel'
          && locationInBounds(
            latitude, longitude, 8.731795, 125.863041, 9.093403, 126.099700
          )
        )
        || (city == 'Tagbina'
          && locationInBounds(
            latitude, longitude, 8.280009, 126.055895, 8.518690, 126.294822
          )
        )
        || (city == 'Tago'
          && locationInBounds(
            latitude, longitude, 8.846151, 126.031491, 9.093730, 126.250260
          )
        );
    }

    function validCaragaLocationSelection(province, city) {
      return (province == 'Agusan del Norte'
          && city in [
            'Buenavista',
            'Butuan City',
            'Carmen',
            'City of Cabadbaran',
            'Jabonga',
            'Kitcharao',
            'Las Nieves',
            'Magallanes',
            'Nasipit',
            'Remedios T. Romualdez',
            'Santiago',
            'Tubay'
          ]
        )
        || (province == 'Agusan del Sur'
          && city in [
            'Bunawan',
            'City of Bayugan',
            'Esperanza',
            'La Paz',
            'Loreto',
            'Prosperidad',
            'Rosario',
            'San Francisco',
            'San Luis',
            'Santa Josefa',
            'Sibagat',
            'Talacogon',
            'Trento',
            'Veruela'
          ]
        )
        || (province == 'Dinagat Islands'
          && city in [
            'Basilisa',
            'Cagdianao',
            'Dinagat',
            'Libjo',
            'Loreto',
            'San Jose',
            'Tubajon'
          ]
        )
        || (province == 'Surigao del Norte'
          && city in [
            'Alegria',
            'Bacuag',
            'Burgos',
            'City of Surigao',
            'Claver',
            'Dapa',
            'Del Carmen',
            'General Luna',
            'Gigaquit',
            'Mainit',
            'Malimono',
            'Pilar',
            'Placer',
            'San Benito',
            'San Francisco',
            'San Isidro',
            'Santa Monica',
            'Sison',
            'Socorro',
            'Tagana-an',
            'Tubod'
          ]
        )
        || (province == 'Surigao del Sur'
          && city in [
            'Barobo',
            'Bayabas',
            'Cagwait',
            'Cantilan',
            'Carmen',
            'Carrascal',
            'City of Bislig',
            'City of Tandag',
            'Cortes',
            'Hinatuan',
            'Lanuza',
            'Lianga',
            'Lingig',
            'Madrid',
            'Marihatag',
            'San Agustin',
            'San Miguel',
            'Tagbina',
            'Tago'
          ]
        );
    }

    function validCaragaLocationPin(latitude, longitude, province, city) {
      return latitude is number
        && longitude is number
        && province is string
        && city is string
        && validCaragaLocationSelection(province, city)
        && ((province == 'Agusan del Norte'
            && validAgusanDelNortePin(latitude, longitude, city)
          )
          || (province == 'Agusan del Sur'
            && validAgusanDelSurPin(latitude, longitude, city)
          )
          || (province == 'Dinagat Islands'
            && validDinagatIslandsPin(latitude, longitude, city)
          )
          || (province == 'Surigao del Norte'
            && validSurigaoDelNortePin(latitude, longitude, city)
          )
          || (province == 'Surigao del Sur'
            && validSurigaoDelSurPin(latitude, longitude, city)
          )
        );
    }

    function validUserLocationUpdate() {
      let changed = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      return !changed.hasAny([
          'province',
          'cityMunicipality',
          'deliveryLatitude',
          'deliveryLongitude',
          'deliveryReferenceType'
        ])
        || (
          request.resource.data.get('region', '') == 'Caraga Region'
          && validCaragaLocationPin(
            request.resource.data.get('deliveryLatitude', null),
            request.resource.data.get('deliveryLongitude', null),
            request.resource.data.get('province', ''),
            request.resource.data.get('cityMunicipality', '')
          )
          && request.resource.data.get('deliveryReferenceType', '')
            == 'map_pin'
        );
    }

    // ---------------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------------

    match /users/{userId} {
      allow get: if signedIn() && (currentUid() == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && currentUid() == userId
        && request.resource.data.get('uid', '') == userId
        && request.resource.data.get('role', '') == 'vendor'
        && request.resource.data.get('accountType', '') == 'vendor'
        && request.resource.data.get('supplierStatus', '') == 'not_applicable';

      allow update: if validAdminUserUpdate(userId)
        || (
          signedIn()
          && currentUid() == userId

          // Identity/privilege fields cannot be self-promoted.
          && request.resource.data.get('uid', userId)
              == resource.data.get('uid', userId)
          && request.resource.data.get('role', 'vendor')
              == resource.data.get('role', 'vendor')
          && request.resource.data.get('accountType', 'vendor')
              == resource.data.get('accountType', 'vendor')
          && request.resource.data.get('createdAt', null)
              == resource.data.get('createdAt', null)

          // A normal account can only keep its supplier status unchanged or
          // submit/resubmit an application into the pending state.
          && (
            request.resource.data.get('supplierStatus', 'not_applicable')
              == resource.data.get('supplierStatus', 'not_applicable')
            || (
              (
                resource.data.get('supplierStatus', 'not_applicable')
                  == 'not_applicable'
                || resource.data.get('supplierStatus', 'not_applicable')
                  == 'rejected'
              )
              && request.resource.data.get('supplierStatus', '')
                == 'pending'
            )
          )

          // Verification evidence may be written only when the account moves
          // into a new pending application. After submission/approval, direct
          // client edits cannot silently replace the stored application copy.
          // Historical participant links are assigned only by the trusted
          // one-time Admin SDK importer. A client cannot relink itself to
          // another field participant ID.
          && request.resource.data.get('historicalVendorId', null)
              == resource.data.get('historicalVendorId', null)
          && request.resource.data.get('historicalSupplierId', null)
              == resource.data.get('historicalSupplierId', null)

          && (
            request.resource.data.get('supplierApplication', null)
              == resource.data.get('supplierApplication', null)
            || (
              (
                resource.data.get('supplierStatus', 'not_applicable')
                  == 'not_applicable'
                || resource.data.get('supplierStatus', 'not_applicable')
                  == 'rejected'
              )
              && request.resource.data.get('supplierStatus', '')
                == 'pending'
            )
          )
          && validUserLocationUpdate()
        );

      allow delete: if false;

      function validAdminUserUpdate(userId) {
        let changed = request.resource.data
          .diff(resource.data)
          .affectedKeys();
        let currentRole = resource.data.get('role', 'vendor');
        let nextRole = request.resource.data.get('role', 'vendor');
        let currentStatus = resource.data.get(
          'supplierStatus',
          'not_applicable'
        );
        let nextStatus = request.resource.data.get(
          'supplierStatus',
          'not_applicable'
        );

        return isAdmin()
          && userId != currentUid()
          && request.resource.data.get('uid', userId)
              == resource.data.get('uid', userId)
          && request.resource.data.get('updatedAt', null) is timestamp
          && (
            (
              currentStatus == 'pending'
              && currentRole == 'vendor'
              && changed.hasOnly([
                'role',
                'supplierStatus',
                'updatedAt'
              ])
              && (
                (
                  nextRole == 'supplier'
                  && nextStatus == 'approved'
                  && existsAfter(supplierPath(userId))
                  && getAfter(supplierPath(userId)).data.get('status', '')
                    == 'approved'
                )
                || (
                  currentRole == 'vendor'
                  && nextRole == 'vendor'
                  && nextStatus == 'rejected'
                  && existsAfter(supplierPath(userId))
                  && getAfter(supplierPath(userId)).data.get('status', '')
                    == 'rejected'
                )
              )
            )
            || (
              currentRole == 'supplier'
              && nextRole == currentRole
              && currentStatus == 'approved'
              && nextStatus == currentStatus
              && changed.hasAll([
                'supplierApplication',
                'updatedAt'
              ])
              && changed.hasOnly([
                'supplierLocation',
                'supplierApplication',
                'profileImageUrl',
                'photoUrl',
                'updatedAt'
              ])
              && exists(changeRequestPath(userId))
              && existsAfter(changeRequestPath(userId))
              && get(changeRequestPath(userId)).data.get('status', '')
                == 'pending'
              && getAfter(changeRequestPath(userId)).data.get('status', '')
                == 'approved'
              && getAfter(changeRequestPath(userId)).data.get(
                'reviewedBy',
                ''
              ) == currentUid()
            )
          );
      }
    }

    // Each signed-in account may register only its own FCM destinations.
    // The Cloud Functions Admin SDK reads these records to deliver pushes.
    match /users/{userId}/pushTokens/{tokenId} {
      allow read: if isAdmin()
        || (signedIn() && currentUid() == userId);

      allow create, update: if signedIn()
        && currentUid() == userId
        && request.resource.data.keys().hasOnly([
          'userId',
          'token',
          'platform',
          'enabled',
          'updatedAt'
        ])
        && request.resource.data.get('userId', '') == userId
        && request.resource.data.get('token', '') is string
        && request.resource.data.get('token', '').size() >= 20
        && request.resource.data.get('token', '').size() <= 1000
        && request.resource.data.get('platform', '') in [
          'android',
          'ios',
          'macos'
        ]
        && request.resource.data.get('enabled', false) == true
        && request.resource.data.get('updatedAt', null) is timestamp;

      allow delete: if signedIn() && currentUid() == userId;
    }

    // ---------------------------------------------------------------------
    // SUPPLIER PROFILES
    //
    // Pending/rejected verification evidence is private to the applicant and
    // administrator. Approved supplier profiles become marketplace-readable.
    // ---------------------------------------------------------------------

    match /supplierProfiles/{supplierId} {
      allow read: if isAdmin()
        || (signedIn() && currentUid() == supplierId)
        || isPublicApprovedSupplier(resource.data);

      allow create: if signedIn()
        && currentUid() == supplierId
        && request.resource.data.get('uid', '') == supplierId
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('verificationStatus', '') == 'pending'
        && request.resource.data.get('paymentMethod', '') == 'COD'
        && validStoreLocationPin(request.resource.data)
        && !request.resource.data.keys().hasAny([
          'rating',
          'reviews',
          'ratingTotal',
          'approvedAt'
        ]);

      allow update: if validAdminSupplierProfileUpdate(supplierId)
        || validOwnerSupplierProfileUpdate(supplierId)
        || validSupplierReapplication(supplierId)
        || validReviewAggregateUpdate(supplierId);

      allow delete: if false;

      function validStoreLocationPin(data) {
        return validCaragaLocationPin(
          data.get('storeLatitude', null),
          data.get('storeLongitude', null),
          data.get('storeProvince', ''),
          data.get('storeCityMunicipality', '')
        );
      }

      function validAdminSupplierProfileUpdate(supplierId) {
        return validAdminSupplierApplicationReview(supplierId)
          || (
            exists(changeRequestPath(supplierId))
            && validAdminVerifiedProfileChange(supplierId)
          );
      }

      function validAdminSupplierApplicationReview(supplierId) {
        let nextStatus = request.resource.data.get('status', '');

        return isAdmin()
          && supplierId != currentUid()
          && request.resource.data.get('uid', supplierId)
              == resource.data.get('uid', supplierId)
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('updatedAt', null) is timestamp
          && (
            (
              nextStatus == 'approved'
              && request.resource.data.get('verificationStatus', '')
                == 'approved'
              && request.resource.data.get('approvedAt', null) is timestamp
              && (
                !request.resource.data.keys().hasAny(['accountCreatedAt'])
                || request.resource.data.get('accountCreatedAt', null)
                  is timestamp
              )
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status',
                  'verificationStatus',
                  'approvedAt',
                  'accountCreatedAt',
                  'ownerAddress',
                  'email',
                  'businessPermitNumber',
                  'businessPermitUrl',
                  'businessPermitStoragePath',
                  'updatedAt'
                ])
              && !request.resource.data.keys().hasAny([
                'ownerAddress',
                'email',
                'businessPermitNumber',
                'businessPermitUrl',
                'businessPermitStoragePath'
              ])
              && existsAfter(userPath(supplierId))
              && getAfter(userPath(supplierId)).data.get('role', '')
                == 'supplier'
              && getAfter(userPath(supplierId)).data.get(
                'supplierStatus',
                ''
              ) == 'approved'
            )
            || (
              nextStatus == 'rejected'
              && request.resource.data.get('verificationStatus', '')
                == 'rejected'
              && request.resource.data.get('rejectionReason', '') is string
              && request.resource.data.get('rejectionReason', '').size() >= 5
              && request.resource.data.get('rejectionReason', '').size() <= 500
              && request.resource.data.get('rejectedBy', '') == currentUid()
              && request.resource.data.get('rejectedAt', null) is timestamp
              && request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status',
                  'verificationStatus',
                  'rejectionReason',
                  'rejectedBy',
                  'rejectedAt',
                  'updatedAt'
                ])
              && existsAfter(userPath(supplierId))
              && getAfter(userPath(supplierId)).data.get('role', '')
                == 'vendor'
              && getAfter(userPath(supplierId)).data.get(
                'supplierStatus',
                ''
              ) == 'rejected'
            )
          );
      }

      function validAdminVerifiedProfileChange(supplierId) {
        let requestedChange = get(changeRequestPath(supplierId)).data;
        let changedFields = requestedChange.get('changedFields', []);

        return isAdmin()
          && supplierId != currentUid()
          && request.resource.data.get('uid', supplierId)
              == resource.data.get('uid', supplierId)
          && resource.data.get('status', '') == 'approved'
          && request.resource.data.get('status', '') == 'approved'
          && request.resource.data.get('verificationStatus', '')
            == resource.data.get('verificationStatus', '')
          && requestedChange.get('status', '') == 'pending'
          && existsAfter(changeRequestPath(supplierId))
          && getAfter(changeRequestPath(supplierId)).data.get('status', '')
            == 'approved'
          && getAfter(changeRequestPath(supplierId)).data.get(
            'reviewedBy',
            ''
          ) == currentUid()
          && request.resource.data.get('updatedAt', null) is timestamp
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'storeName',
              'supplierName',
              'businessName',
              'storeProvince',
              'storeCityMunicipality',
              'storeAddress',
              'storeLatitude',
              'storeLongitude',
              'location',
              'storeLocation',
              'storePhotoUrl',
              'coverImageUrl',
              'profileImageUrl',
              'photoUrl',
              'updatedAt'
            ])
          && (
            (
              changedFields.hasAny(['Store name'])
              && request.resource.data.get('storeName', '')
                == requestedChange.get('requestedStoreName', '')
              && request.resource.data.get('supplierName', '')
                == requestedChange.get('requestedStoreName', '')
              && request.resource.data.get('businessName', '')
                == requestedChange.get('requestedStoreName', '')
            )
            || (
              !changedFields.hasAny(['Store name'])
              && request.resource.data.get('storeName', '')
                == resource.data.get('storeName', '')
              && request.resource.data.get('supplierName', '')
                == resource.data.get('supplierName', '')
              && request.resource.data.get('businessName', '')
                == resource.data.get('businessName', '')
            )
          )
          && (
            (
              changedFields.hasAny(['Business location'])
              && request.resource.data.get('storeProvince', '')
                == requestedChange.get('requestedStoreProvince', '')
              && request.resource.data.get('storeCityMunicipality', '')
                == requestedChange.get(
                  'requestedStoreCityMunicipality',
                  ''
                )
              && request.resource.data.get('storeAddress', '')
                == requestedChange.get('requestedStoreAddress', '')
              && request.resource.data.get('storeLatitude', null)
                == requestedChange.get('requestedStoreLatitude', null)
              && request.resource.data.get('storeLongitude', null)
                == requestedChange.get('requestedStoreLongitude', null)
              && request.resource.data.get('location', '')
                == requestedChange.get('requestedLocation', '')
              && request.resource.data.get('storeLocation', '')
                == requestedChange.get('requestedLocation', '')
              && validStoreLocationPin(request.resource.data)
            )
            || (
              !changedFields.hasAny(['Business location'])
              && request.resource.data.get('storeProvince', '')
                == resource.data.get('storeProvince', '')
              && request.resource.data.get('storeCityMunicipality', '')
                == resource.data.get('storeCityMunicipality', '')
              && request.resource.data.get('storeAddress', '')
                == resource.data.get('storeAddress', '')
              && request.resource.data.get('storeLatitude', null)
                == resource.data.get('storeLatitude', null)
              && request.resource.data.get('storeLongitude', null)
                == resource.data.get('storeLongitude', null)
              && request.resource.data.get('location', '')
                == resource.data.get('location', '')
              && request.resource.data.get('storeLocation', '')
                == resource.data.get('storeLocation', '')
            )
          )
          && (
            (
              changedFields.hasAny(['Store photo'])
              && request.resource.data.get('storePhotoUrl', '')
                == requestedChange.get('requestedStorePhotoUrl', '')
              && request.resource.data.get('coverImageUrl', '')
                == requestedChange.get('requestedStorePhotoUrl', '')
              && request.resource.data.get('profileImageUrl', '')
                == requestedChange.get('requestedStorePhotoUrl', '')
              && request.resource.data.get('photoUrl', '')
                == requestedChange.get('requestedStorePhotoUrl', '')
            )
            || (
              !changedFields.hasAny(['Store photo'])
              && request.resource.data.get('storePhotoUrl', '')
                == resource.data.get('storePhotoUrl', '')
              && request.resource.data.get('coverImageUrl', '')
                == resource.data.get('coverImageUrl', '')
              && request.resource.data.get('profileImageUrl', '')
                == resource.data.get('profileImageUrl', '')
              && request.resource.data.get('photoUrl', '')
                == resource.data.get('photoUrl', '')
            )
          );
      }

      function validOwnerSupplierProfileUpdate(supplierId) {
        let changed = request.resource.data
          .diff(resource.data)
          .affectedKeys();
        let phone = request.resource.data.get('phone', '');
        let contact = request.resource.data.get('contactNumber', '');
        let marketArea = request.resource.data.get('primaryMarketArea', '');
        let serviceArea = request.resource.data.get('serviceArea', '');
        let description = request.resource.data.get('description', '');
        let units = request.resource.data.get('supportedUnits', []);

        return signedIn()
          && currentUid() == supplierId
          && resource.data.get('status', '') == 'approved'
          && request.resource.data.get('uid', supplierId)
              == resource.data.get('uid', supplierId)
          && request.resource.data.get('status', '')
              == resource.data.get('status', '')
          && request.resource.data.get('verificationStatus', '')
              == resource.data.get('verificationStatus', '')
          && request.resource.data.get('ownerName', '')
              == resource.data.get('ownerName', '')
          && request.resource.data.get('storeName', '')
              == resource.data.get('storeName', '')
          && request.resource.data.get('businessName', '')
              == resource.data.get('businessName', '')
          && request.resource.data.get('supplierName', '')
              == resource.data.get('supplierName', '')
          && request.resource.data.get('storeProvince', '')
              == resource.data.get('storeProvince', '')
          && request.resource.data.get('storeCityMunicipality', '')
              == resource.data.get('storeCityMunicipality', '')
          && request.resource.data.get('storeAddress', '')
              == resource.data.get('storeAddress', '')
          && request.resource.data.get('storeLatitude', null)
              == resource.data.get('storeLatitude', null)
          && request.resource.data.get('storeLongitude', null)
              == resource.data.get('storeLongitude', null)
          && request.resource.data.get('storeLocation', '')
              == resource.data.get('storeLocation', '')
          && request.resource.data.get('storePhotoUrl', '')
              == resource.data.get('storePhotoUrl', '')
          && request.resource.data.get('businessPermitNumber', '')
              == resource.data.get('businessPermitNumber', '')
          && request.resource.data.get('businessPermitUrl', '')
              == resource.data.get('businessPermitUrl', '')
          && request.resource.data.get('businessPermitStoragePath', '')
              == resource.data.get('businessPermitStoragePath', '')
          && request.resource.data.get('rating', 0)
              == resource.data.get('rating', 0)
          && request.resource.data.get('reviews', 0)
              == resource.data.get('reviews', 0)
          && request.resource.data.get('ratingTotal', 0)
              == resource.data.get('ratingTotal', 0)
          && (
            !changed.hasAny(['phone', 'contactNumber'])
            || (
              phone is string
              && contact is string
              && phone == contact
              && phone.size() >= 7
              && phone.size() <= 30
            )
          )
          && (
            !changed.hasAny(['primaryMarketArea', 'serviceArea'])
            || (
              marketArea is string
              && marketArea.size() >= 2
              && marketArea.size() <= 120
              && serviceArea == marketArea
            )
          )
          && (
            !changed.hasAny(['description'])
            || (
              description is string
              && description.size() >= 8
              && description.size() <= 240
            )
          )
          && (
            !changed.hasAny(['supportedUnits'])
            || (
              units is list
              && units.size() >= 1
              && units.size() <= 3
              && units.hasOnly(['kilo', 'tab', 'icebox'])
            )
          )
          && changedOnly([
            'phone',
            'contactNumber',
            'profileImageUrl',
            'primaryMarketArea',
            'serviceArea',
            'description',
            'supportedUnits',
            'updatedAt'
          ]);
      }

      function validSupplierReapplication(supplierId) {
        return signedIn()
          && currentUid() == supplierId
          && resource.data.get('status', '') == 'rejected'
          && request.resource.data.get('uid', supplierId) == supplierId
          && request.resource.data.get('status', '') == 'pending'
          && request.resource.data.get('verificationStatus', '') == 'pending'
          && request.resource.data.get('paymentMethod', '') == 'COD'
          && validStoreLocationPin(request.resource.data)
          && request.resource.data.get('rating', 0)
              == resource.data.get('rating', 0)
          && request.resource.data.get('reviews', 0)
              == resource.data.get('reviews', 0)
          && request.resource.data.get('ratingTotal', 0)
              == resource.data.get('ratingTotal', 0)
          && changedOnly([
            'uid',
            'ownerName',
            'ownerAddress',
            'email',
            'contactNumber',
            'phone',
            'storeName',
            'supplierName',
            'businessName',
            'supplierType',
            'region',
            'storeProvince',
            'storeCityMunicipality',
            'storeAddress',
            'storeLatitude',
            'storeLongitude',
            'location',
            'storeLocation',
            'primaryMarketArea',
            'serviceArea',
            'description',
            'supportedUnits',
            'businessPermitNumber',
            'businessPermitUrl',
            'businessPermitStoragePath',
            'storePhotoUrl',
            'coverImageUrl',
            'profileImageUrl',
            'hasBusinessPermit',
            'hasStorePhoto',
            'verificationStatus',
            'paymentMethod',
            'applicationVersion',
            'accountCreatedAt',
            'submittedAt',
            'status',
            'rejectionReason',
            'rejectedBy',
            'rejectedAt',
            'createdAt',
            'updatedAt'
          ]);
      }

      function validReviewAggregateUpdate(supplierId) {
        let orderId = request.resource.data.get('lastReviewOrderId', '');
        let afterReview = getAfter(reviewPath(orderId)).data;
        let oldCount = resource.data.get('reviews', 0);
        let oldTotal = resource.data.get(
          'ratingTotal',
          resource.data.get('rating', 0) * oldCount
        );
        let newCount = request.resource.data.get('reviews', 0);
        let newTotal = request.resource.data.get('ratingTotal', 0);

        return signedIn()
          && orderId is string
          && orderId.size() > 0
          && existsAfter(reviewPath(orderId))
          && afterReview.get('orderId', '') == orderId
          && afterReview.get('supplierId', '') == supplierId
          && afterReview.get('vendorId', '') == currentUid()
          && afterReview.get('rating', 0) is int
          && afterReview.get('rating', 0) >= 1
          && afterReview.get('rating', 0) <= 5
          && changedOnly([
            'rating',
            'reviews',
            'ratingTotal',
            'lastReviewOrderId',
            'updatedAt'
          ])
          && (
            (
              !exists(reviewPath(orderId))
              && newCount == oldCount + 1
              && newTotal == oldTotal + afterReview.get('rating', 0)
              && request.resource.data.get('rating', 0)
                == newTotal / newCount
            )
            || (
              exists(reviewPath(orderId))
              && get(reviewPath(orderId)).data.get('vendorId', '')
                == currentUid()
              && newCount == oldCount
              && newCount > 0
              && newTotal
                == oldTotal
                  - get(reviewPath(orderId)).data.get('rating', 0)
                  + afterReview.get('rating', 0)
              && request.resource.data.get('rating', 0)
                == newTotal / newCount
            )
          );
      }
    }

    // ---------------------------------------------------------------------
    // SUPPLIER VERIFIED PROFILE CHANGE REQUESTS
    //
    // Approved suppliers may request changes to verified identity/location
    // information, but cannot write those changes directly into the public
    // approved supplier profile. The administrator reviews the request first.
    // ---------------------------------------------------------------------

    match /supplierChangeRequests/{supplierId} {
      allow read: if isAdmin()
        || (signedIn() && currentUid() == supplierId);

      allow create: if validPendingSupplierChangeRequest(supplierId);

      allow update: if validAdminSupplierChangeReview(supplierId)
        || validSupplierChangeWithdrawal(supplierId)
        || (
          resource.data.get('supplierId', '') == supplierId
          && resource.data.get('status', '') in [
            'approved',
            'rejected',
            'withdrawn'
          ]
          && validPendingSupplierChangeRequest(supplierId)
        );

      allow delete: if false;

      function validAdminSupplierChangeReview(supplierId) {
        return isAdmin()
          && supplierId != currentUid()
          && resource.data.get('supplierId', '') == supplierId
          && request.resource.data.get('supplierId', '') == supplierId
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') in [
            'approved',
            'rejected'
          ]
          && request.resource.data.get('reviewedBy', '') == currentUid()
          && request.resource.data.get('adminNote', '') is string
          && request.resource.data.get('adminNote', '').size() <= 500
          && (
            request.resource.data.get('status', '') == 'approved'
            || request.resource.data.get('adminNote', '').size() >= 3
          )
          && request.resource.data.get('reviewedAt', null) is timestamp
          && request.resource.data.get('updatedAt', null) is timestamp
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'adminNote',
              'reviewedAt',
              'reviewedBy',
              'updatedAt'
            ]);
      }

      function validSupplierChangeWithdrawal(supplierId) {
        return signedIn()
          && currentUid() == supplierId
          && resource.data.get('supplierId', '') == supplierId
          && resource.data.get('status', '') == 'pending'
          && request.resource.data.get('status', '') == 'withdrawn'
          && request.resource.data.get('withdrawnAt', null) is timestamp
          && request.resource.data.get('updatedAt', null) is timestamp
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'withdrawnAt',
              'updatedAt'
            ]);
      }

      function validRequestedBusinessPin(data) {
        return validCaragaLocationPin(
          data.get('requestedStoreLatitude', null),
          data.get('requestedStoreLongitude', null),
          data.get('requestedStoreProvince', ''),
          data.get('requestedStoreCityMunicipality', '')
        );
      }

      function validRequestedCaragaLocation(province, city) {
        return validCaragaLocationSelection(province, city);
      }

      function validPendingSupplierChangeRequest(supplierId) {
        let changedFields = request.resource.data.get('changedFields', []);
        let supplierName = request.resource.data.get('supplierName', '');
        let reason = request.resource.data.get('reason', '');
        let storeName = request.resource.data.get('requestedStoreName', '');
        let province = request.resource.data.get('requestedStoreProvince', '');
        let city = request.resource.data.get('requestedStoreCityMunicipality', '');
        let address = request.resource.data.get('requestedStoreAddress', '');
        let location = request.resource.data.get('requestedLocation', '');
        let permitNumber = request.resource.data.get(
          'requestedBusinessPermitNumber',
          ''
        );
        return signedIn()
          && currentUid() == supplierId
          && isApprovedSupplierAccount(supplierId)
          && exists(supplierPath(supplierId))
          && get(supplierPath(supplierId)).data.get('status', '') == 'approved'
          && request.resource.data.keys().hasOnly([
            'supplierId',
            'supplierName',
            'requestType',
            'status',
            'reason',
            'requestedStoreName',
            'requestedStoreProvince',
            'requestedStoreCityMunicipality',
            'requestedStoreAddress',
            'requestedStoreLatitude',
            'requestedStoreLongitude',
            'requestedLocation',
            'requestedBusinessPermitNumber',
            'requestedBusinessPermitUrl',
            'requestedBusinessPermitStoragePath',
            'requestedStorePhotoUrl',
            'changedFields',
            'submittedAt',
            'updatedAt'
          ])
          && request.resource.data.get('supplierId', '') == supplierId
          && supplierName is string
          && supplierName.size() >= 2
          && supplierName.size() <= 100
          && supplierName == get(supplierPath(supplierId)).data.get(
            'storeName',
            get(supplierPath(supplierId)).data.get('supplierName', '')
          )
          && request.resource.data.get('requestType', '')
              == 'verified_business_change'
          && request.resource.data.get('status', '') == 'pending'
          && reason is string
          && reason.size() >= 8
          && reason.size() <= 240
          && storeName is string
          && storeName.size() >= 2
          && storeName.size() <= 100
          && province is string
          && city is string
          && validRequestedCaragaLocation(province, city)
          && address is string
          && address.size() >= 5
          && address.size() <= 160
          && location is string
          && location == address + ', ' + city + ', ' + province + ', Caraga Region'
          && location.size() <= 320
          && permitNumber is string
          && permitNumber.size() >= 3
          && permitNumber.size() <= 80
          && request.resource.data.get('requestedBusinessPermitUrl', '')
              is string
          && request.resource.data.get('requestedBusinessPermitUrl', '')
              .size() <= 1000
          && request.resource.data.get(
            'requestedBusinessPermitStoragePath',
            ''
          ) is string
          && request.resource.data.get(
            'requestedBusinessPermitStoragePath',
            ''
          ).size() <= 500
          && (
            (
              request.resource.data.get(
                'requestedBusinessPermitStoragePath',
                ''
              ).size() >= 20
              && request.resource.data.get(
                'requestedBusinessPermitStoragePath',
                ''
              ).matches(
                'supplier_verification/'
                + supplierId
                + '/permits/[^/]+'
              )
            )
            || (
              request.resource.data.get('requestedBusinessPermitUrl', '')
                  .size() >= 8
              && request.resource.data.get(
                'requestedBusinessPermitUrl',
                ''
              ).matches('https://.*')
            )
          )
          && request.resource.data.get('requestedStorePhotoUrl', '') is string
          && request.resource.data.get('requestedStorePhotoUrl', '').size()
              >= 8
          && request.resource.data.get('requestedStorePhotoUrl', '').size()
              <= 1000
          && request.resource.data.get('requestedStorePhotoUrl', '')
              .matches('https://.*')
          && changedFields is list
          && changedFields.size() >= 1
          && changedFields.size() <= 4
          && changedFields.hasOnly([
            'Store name',
            'Business location',
            'Business permit',
            'Store photo'
          ])
          && request.resource.data.get('submittedAt', null) is timestamp
          && request.resource.data.get('updatedAt', null) is timestamp
          && validRequestedBusinessPin(request.resource.data);
      }
    }

    // ---------------------------------------------------------------------
    // FISH STOCKS
    //
    // Signed-in marketplace users may read stock listings because quantity,
    // price and unit availability are required for ordering. Only the owning
    // approved supplier may manage listing content. Vendor quantity changes
    // are limited to validated COD order/cancellation transactions.
    // ---------------------------------------------------------------------

    match /fishStocks/{stockId} {
      allow read: if signedIn();

      allow create: if validSupplierStockCreate();

      allow update: if validSupplierStockUpdate()
        || validVendorPurchaseStockUpdate(stockId)
        || validVendorCancellationStockRestore(stockId);

      // Preserve listing/order history. Suppliers archive listings instead
      // of hard-deleting fishStocks documents.
      allow delete: if false;

      function validSupplierStockCreate() {
        return signedIn()
          && request.resource.data.get('supplierId', '') == currentUid()
          && isApprovedSupplierAccount(currentUid())
          && request.resource.data.keys().hasOnly([
            'productName',
            'category',
            'description',
            'emoji',
            'imageUrl',
            'productImageUrl',
            'price',
            'priceUnit',
            'quantity',
            'quantityUnit',
            'referenceStockQuantity',
            'lowStockPercentage',
            'lowStockLevel',
            'lowStockAlertEnabled',
            'lowStockNotificationEnabled',
            'lastLowStockNotificationAt',
            'lastLowStockNotificationStatus',
            'stockStatus',
            'paymentMethod',
            'supplierId',
            'supplierName',
            'supplierLocation',
            'supplierContactNumber',
            'region',
            'status',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.get('quantity', 0) > 0
          && request.resource.data.get('status', '') == 'available'
          && request.resource.data.get('isActive', false) == true
          && validSupplierStockIdentity(
            request.resource.data,
            currentUid()
          )
          && validStockCoreData(request.resource.data);
      }

      function validSupplierStockUpdate() {
        return signedIn()
          && resource.data.get('supplierId', '') == currentUid()
          && isApprovedSupplierAccount(currentUid())
          && request.resource.data.get('supplierId', '') == currentUid()
          && request.resource.data.get('supplierName', '')
            == resource.data.get('supplierName', '')
          && request.resource.data.get('supplierLocation', '')
            == resource.data.get('supplierLocation', '')
          && request.resource.data.get('supplierContactNumber', '')
            == resource.data.get('supplierContactNumber', '')
          && request.resource.data.get('region', '')
            == resource.data.get('region', '')
          && request.resource.data.get('createdAt', null)
            == resource.data.get('createdAt', null)
          && changedOnly([
            'productName',
            'description',
            'category',
            'imageUrl',
            'productImageUrl',
            'price',
            'priceUnit',
            'quantity',
            'quantityUnit',
            'referenceStockQuantity',
            'lowStockPercentage',
            'lowStockLevel',
            'lowStockAlertEnabled',
            'lowStockNotificationEnabled',
            'lastLowStockNotificationAt',
            'lastLowStockNotificationStatus',
            'stockStatus',
            'status',
            'isActive',
            'restockedAt',
            'updatedAt',
            'archived',
            'archivedAt',
            'restoredFromArchiveAt',
            'lastPartialFulfillmentOrderId',
            'lastStockRestoreOrderId'
          ])
          && validStockCoreData(request.resource.data);
      }

      function validSupplierStockIdentity(data, supplierId) {
        let profile = get(supplierPath(supplierId)).data;

        return exists(supplierPath(supplierId))
          && profile.get('status', '') == 'approved'
          && data.get('supplierName', '')
            == profile.get('supplierName', '')
          && data.get('supplierLocation', '')
            == profile.get('location', '')
          && data.get('supplierContactNumber', '')
            == profile.get(
              'phone',
              profile.get('contactNumber', '')
            );
      }

      function validStockCoreData(data) {
        let quantity = data.get('quantity', -1);
        let referenceQuantity = data.get('referenceStockQuantity', -1);
        let lowStockPercentage = data.get('lowStockPercentage', -1);
        let lowStockLevel = data.get('lowStockLevel', -1);
        let imageUrl = data.get('imageUrl', '');
        let unit = data.get('quantityUnit', '');

        return data.get('productName', '') is string
          && data.get('productName', '').size() >= 2
          && data.get('productName', '').size() <= 100
          && data.get('description', '') is string
          && data.get('description', '').size() >= 8
          && data.get('description', '').size() <= 1000
          && data.get('category', '') in [
            'Fresh Fish',
            'Marine Fish',
            'Aquaculture Fish',
            'Bulk Fish Supply'
          ]
          && data.get('emoji', '') is string
          && data.get('emoji', '').size() <= 16
          && imageUrl is string
          && imageUrl.size() >= 8
          && imageUrl.size() <= 1000
          && imageUrl.matches('https://.*')
          && data.get('productImageUrl', '') == imageUrl
          && data.get('price', 0) is number
          && data.get('price', 0) > 0
          && data.get('price', 0) <= 1000000
          && unit in ['kilo', 'tab', 'icebox']
          && (
            (unit == 'kilo' && data.get('priceUnit', '') == 'per kilo')
            || (unit == 'tab' && data.get('priceUnit', '') == 'per tab')
            || (
              unit == 'icebox'
              && data.get('priceUnit', '') == 'per icebox'
            )
          )
          && quantity is number
          && quantity >= 0
          && quantity <= 1000000
          && referenceQuantity is number
          && referenceQuantity >= 0
          && referenceQuantity <= 1000000
          && lowStockPercentage is number
          && lowStockPercentage >= 1
          && lowStockPercentage <= 100
          && lowStockLevel is number
          && lowStockLevel >= 0
          && lowStockLevel <= referenceQuantity
          && data.get('lowStockAlertEnabled', false) == true
          && data.get('lowStockNotificationEnabled', false) == true
          && (
            data.get('lastLowStockNotificationAt', null) == null
            || data.get('lastLowStockNotificationAt', null) is timestamp
          )
          && (
            data.get('lastLowStockNotificationStatus', null) == null
            || data.get('lastLowStockNotificationStatus', '') in [
              'lowStock',
              'outOfStock'
            ]
          )
          && data.get('paymentMethod', '') == 'COD'
          && data.get('region', '') == 'Caraga Region'
          && data.get('createdAt', null) is timestamp
          && data.get('updatedAt', null) is timestamp
          && data.get('archived', false) is bool
          && validStockVisibilityState(data);
      }

      function validStockVisibilityState(data) {
        let quantity = data.get('quantity', -1);
        let threshold = data.get('lowStockLevel', -1);
        let active = data.get('isActive', false);
        let status = data.get('status', '');
        let stockStatus = data.get('stockStatus', '');

        return (
            active == false
            && status == 'unavailable'
            && stockStatus == 'hidden'
          )
          || (
            active == true
            && status == 'available'
            && data.get('archived', false) == false
            && (
              (quantity <= 0 && stockStatus == 'outOfStock')
              || (
                quantity > 0
                && threshold > 0
                && quantity <= threshold
                && stockStatus == 'lowStock'
              )
              || (
                quantity > 0
                && (threshold <= 0 || quantity > threshold)
                && stockStatus == 'available'
              )
            )
          );
      }

      function validVendorPurchaseStockUpdate(stockId) {
        let orderId = request.resource.data.get('lastOrderId', '');
        let afterOrder = getAfter(orderPath(orderId)).data;

        return signedIn()
          && resource.data.get('supplierId', '') != currentUid()
          && orderId is string
          && orderId.size() > 0
          && !exists(orderPath(orderId))
          && existsAfter(orderPath(orderId))
          && changedOnly([
            'quantity',
            'stockStatus',
            'lastLowStockNotificationAt',
            'lastLowStockNotificationStatus',
            'lastOrderId',
            'updatedAt'
          ])
          && request.resource.data.get('supplierId', '')
              == resource.data.get('supplierId', '')
          && request.resource.data.get('status', '')
              == resource.data.get('status', '')
          && request.resource.data.get('isActive', true)
              == resource.data.get('isActive', true)
          && request.resource.data.get('quantity', 0)
              < resource.data.get('quantity', 0)
          && validStockCoreData(request.resource.data)
          && afterOrder.get('vendorId', '') == currentUid()
          && afterOrder.get('supplierId', '')
              == resource.data.get('supplierId', '')
          && afterOrder.get('stockId', '') == stockId
          && afterOrder.get('quantity', 0)
              == resource.data.get('quantity', 0)
                - request.resource.data.get('quantity', 0)
          && afterOrder.get('orderStatus', '') == 'Pending'
          && afterOrder.get('paymentMethod', '') == 'COD'
          && afterOrder.get('stockDeducted', false) == true
          && afterOrder.get('stockRestored', true) == false;
      }

      function validVendorCancellationStockRestore(stockId) {
        let orderId = request.resource.data.get(
          'lastStockRestoreOrderId',
          ''
        );
        let afterOrder = getAfter(orderPath(orderId)).data;

        return signedIn()
          && resource.data.get('supplierId', '') != currentUid()
          && orderId is string
          && orderId.size() > 0
          && exists(orderPath(orderId))
          && existsAfter(orderPath(orderId))
          && changedOnly([
            'quantity',
            'stockStatus',
            'lastLowStockNotificationAt',
            'lastLowStockNotificationStatus',
            'lastStockRestoreOrderId',
            'updatedAt'
          ])
          && request.resource.data.get('supplierId', '')
              == resource.data.get('supplierId', '')
          && request.resource.data.get('status', '')
              == resource.data.get('status', '')
          && request.resource.data.get('isActive', true)
              == resource.data.get('isActive', true)
          && request.resource.data.get('quantity', 0)
              > resource.data.get('quantity', 0)
          && validStockCoreData(request.resource.data)
          && afterOrder.get('vendorId', '') == currentUid()
          && afterOrder.get('stockId', '') == stockId
          && afterOrder.get('orderStatus', '') == 'Cancelled'
          && afterOrder.get('cancelledBy', '') == 'vendor'
          && afterOrder.get('stockRestored', false) == true
          && afterOrder.get('quantity', 0)
              == request.resource.data.get('quantity', 0)
                - resource.data.get('quantity', 0);
      }
    }

    // ---------------------------------------------------------------------
    // ORDERS
    // ---------------------------------------------------------------------

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.get('vendorId', '') == currentUid()
            || resource.data.get('supplierId', '') == currentUid()
          )
        );

      allow create: if validCodOrderCreate(orderId);

      allow update: if validVendorCancellation(orderId)
        || validSupplierOrderTransition(orderId)
        || validNewReviewOrderUpdate(orderId)
        || validEditedReviewOrderUpdate(orderId);

      allow delete: if false;

      function validCodOrderCreate(orderId) {
        let stockId = request.resource.data.get('stockId', '');
        let beforeStock = get(stockPath(stockId)).data;
        let afterStock = getAfter(stockPath(stockId)).data;
        let orderedQuantity = request.resource.data.get('quantity', 0);

        return signedIn()
          && stockId is string
          && stockId.size() > 0
          && exists(stockPath(stockId))
          && existsAfter(stockPath(stockId))
          && request.resource.data.get('vendorId', '') == currentUid()
          && request.resource.data.get('supplierId', '') != currentUid()
          && request.resource.data.get('supplierId', '')
              == beforeStock.get('supplierId', '')
          && request.resource.data.get('fishStockId', '') == stockId
          && request.resource.data.get('productName', '')
              == beforeStock.get('productName', '')
          && request.resource.data.get('quantityUnit', '')
              == beforeStock.get('quantityUnit', '')
          && request.resource.data.get('unitPrice', -1)
              == beforeStock.get('price', -2)
          && orderedQuantity is number
          && orderedQuantity > 0
          && beforeStock.get('quantity', 0) >= orderedQuantity
          && beforeStock.get('status', 'available') != 'unavailable'
          && beforeStock.get('isActive', true) == true
          && request.resource.data.get('totalAmount', -1)
              == beforeStock.get('price', 0) * orderedQuantity
          && request.resource.data.get('paymentMethod', '') == 'COD'
          && validDeliveryReferencePin(request.resource.data)
          && request.resource.data.get('paymentStatus', '')
              == 'To be paid on delivery'
          && request.resource.data.get('orderStatus', '') == 'Pending'
          && request.resource.data.get('stockDeducted', false) == true
          && request.resource.data.get('stockRestored', true) == false
          && afterStock.get('supplierId', '')
              == beforeStock.get('supplierId', '')
          && afterStock.get('quantity', 0)
              == beforeStock.get('quantity', 0) - orderedQuantity
          && afterStock.get('lastOrderId', '') == orderId;
      }

      function validDeliveryReferencePin(data) {
        return validCaragaLocationPin(
          data.get('deliveryLatitude', null),
          data.get('deliveryLongitude', null),
          data.get('deliveryProvince', ''),
          data.get('deliveryCityMunicipality', '')
        )
          && data.get('deliveryReferenceType', '') == 'map_pin';
      }

      function validVendorCancellation(orderId) {
        return signedIn()
          && resource.data.get('vendorId', '') == currentUid()
          && resource.data.get('orderStatus', '') == 'Pending'
          && request.resource.data.get('orderStatus', '') == 'Cancelled'
          && request.resource.data.get('paymentStatus', '') == 'Cancelled'
          && request.resource.data.get('cancelledBy', '') == 'vendor'
          && changedOnly([
            'orderStatus',
            'paymentStatus',
            'stockRestored',
            'stockRestorePending',
            'cancelledBy',
            'cancelledAt',
            'restoredAt',
            'updatedAt'
          ])
          && validCancellationRestoration(orderId);
      }

      function validSupplierOrderTransition(orderId) {
        let currentStatus = resource.data.get('orderStatus', '');
        let nextStatus = request.resource.data.get('orderStatus', '');

        return signedIn()
          && resource.data.get('supplierId', '') == currentUid()
          && (
            (
              currentStatus == 'Pending'
              && nextStatus == 'Accepted'
              && request.resource.data.get('paymentStatus', '')
                == 'To be paid on delivery'
              && changedOnly([
                'orderStatus',
                'paymentStatus',
                'fulfilledQuantity',
                'unfulfilledQuantity',
                'fulfilledTotalAmount',
                'reservedQuantity',
                'partialFulfillment',
                'fulfillmentStatus',
                'partialStockRestored',
                'partialRestoredQuantity',
                'partialRestoredAt',
                'acceptedAt',
                'updatedAt'
              ])
              && validSupplierAcceptance(orderId)
            )
            || (
              currentStatus == 'Accepted'
              && nextStatus == 'Delivered'
              && request.resource.data.get('paymentStatus', '') == 'Paid'
              && request.resource.data.get('isReviewEligible', false) == true
              && changedOnly([
                'orderStatus',
                'paymentStatus',
                'deliveredAt',
                'completedAt',
                'isReviewEligible',
                'updatedAt'
              ])
            )
            || (
              (
                currentStatus == 'Pending'
                || currentStatus == 'Accepted'
              )
              && nextStatus == 'Cancelled'
              && request.resource.data.get('paymentStatus', '') == 'Cancelled'
              && request.resource.data.get('cancelledBy', '') == 'supplier'
              && changedOnly([
                'orderStatus',
                'paymentStatus',
                'stockRestored',
                'stockRestorePending',
                'cancelledBy',
                'cancelledAt',
                'restoredAt',
                'updatedAt'
              ])
              && validCancellationRestoration(orderId)
            )
          );
      }

      function validSupplierAcceptance(orderId) {
        let ordered = resource.data.get('quantity', 0);
        let fulfilled = request.resource.data.get(
          'fulfilledQuantity',
          0
        );
        let unfulfilled = request.resource.data.get(
          'unfulfilledQuantity',
          0
        );
        let unitPrice = resource.data.get('unitPrice', 0);
        let expectedTotal = unitPrice * fulfilled;
        let partial = fulfilled < ordered;
        let stockId = resource.data.get('stockId', '');

        return ordered is number
          && ordered > 0
          && fulfilled is number
          && fulfilled > 0
          && fulfilled <= ordered
          && unfulfilled == ordered - fulfilled
          && request.resource.data.get('reservedQuantity', 0)
            == fulfilled
          && request.resource.data.get('fulfilledTotalAmount', -1)
            >= expectedTotal - 0.01
          && request.resource.data.get('fulfilledTotalAmount', -1)
            <= expectedTotal + 0.01
          && request.resource.data.get(
            'partialFulfillment',
            false
          ) == partial
          && request.resource.data.get(
            'fulfillmentStatus',
            ''
          ) == (partial ? 'partial' : 'full')
          && request.resource.data.get(
            'partialStockRestored',
            false
          ) == partial
          && request.resource.data.get(
            'partialRestoredQuantity',
            -1
          ) == unfulfilled
          && (
            !partial
            || (
              stockId is string
              && stockId.size() > 0
              && exists(stockPath(stockId))
              && existsAfter(stockPath(stockId))
              && getAfter(stockPath(stockId)).data.get(
                'lastPartialFulfillmentOrderId',
                ''
              ) == orderId
              && getAfter(stockPath(stockId)).data.get(
                'quantity',
                0
              ) == get(stockPath(stockId)).data.get(
                'quantity',
                0
              ) + unfulfilled
            )
          );
      }

      function validCancellationRestoration(orderId) {
        let stockId = resource.data.get('stockId', '');
        let fulfilled = resource.data.get(
          'fulfilledQuantity',
          0
        );
        let restorableQuantity =
          fulfilled > 0
            ? fulfilled
            : resource.data.get('quantity', 0);

        return (
          resource.data.get('stockDeducted', false) != true
          && request.resource.data.get('stockRestored', false) == true
        )
        || (
          stockId is string
          && stockId.size() > 0
          && !exists(stockPath(stockId))
          && request.resource.data.get('stockRestored', true) == false
          && request.resource.data.get('stockRestorePending', false) == true
        )
        || (
          stockId is string
          && stockId.size() > 0
          && exists(stockPath(stockId))
          && existsAfter(stockPath(stockId))
          && request.resource.data.get('stockRestored', false) == true
          && request.resource.data.get('stockRestorePending', true) == false
          && getAfter(stockPath(stockId)).data.get(
            'lastStockRestoreOrderId',
            ''
          ) == orderId
          && getAfter(stockPath(stockId)).data.get('quantity', 0)
            == get(stockPath(stockId)).data.get('quantity', 0)
              + restorableQuantity
        );
      }

      function validNewReviewOrderUpdate(orderId) {
        let afterReview = getAfter(reviewPath(orderId)).data;

        return signedIn()
          && resource.data.get('vendorId', '') == currentUid()
          && isCompletedOrder(resource.data)
          && resource.data.get('reviewSubmitted', false) != true
          && !exists(reviewPath(orderId))
          && existsAfter(reviewPath(orderId))
          && request.resource.data.get('reviewSubmitted', false) == true
          && afterReview.get('orderId', '') == orderId
          && afterReview.get('vendorId', '') == currentUid()
          && afterReview.get('supplierId', '')
              == resource.data.get('supplierId', '')
          && request.resource.data.get('reviewRating', 0)
              == afterReview.get('rating', 0)
          && request.resource.data.get('reviewComment', '')
              == afterReview.get('comment', '')
          && request.resource.data.get('reviewedAt', null) is timestamp
          && request.resource.data.get('updatedAt', null) is timestamp
          && changedOnly([
            'reviewSubmitted',
            'reviewRating',
            'reviewComment',
            'reviewedAt',
            'updatedAt'
          ]);
      }

      function validEditedReviewOrderUpdate(orderId) {
        let afterReview = getAfter(reviewPath(orderId)).data;

        return signedIn()
          && resource.data.get('vendorId', '') == currentUid()
          && isCompletedOrder(resource.data)
          && exists(reviewPath(orderId))
          && existsAfter(reviewPath(orderId))
          && get(reviewPath(orderId)).data.get('vendorId', '')
              == currentUid()
          && request.resource.data.get('reviewSubmitted', false) == true
          && afterReview.get('orderId', '') == orderId
          && afterReview.get('vendorId', '') == currentUid()
          && afterReview.get('supplierId', '')
              == resource.data.get('supplierId', '')
          && request.resource.data.get('reviewRating', 0)
              == afterReview.get('rating', 0)
          && request.resource.data.get('reviewComment', '')
              == afterReview.get('comment', '')
          && request.resource.data.get('reviewUpdatedAt', null) is timestamp
          && request.resource.data.get('updatedAt', null) is timestamp
          && changedOnly([
            'reviewSubmitted',
            'reviewRating',
            'reviewComment',
            'reviewUpdatedAt',
            'updatedAt'
          ]);
      }
    }

    // ---------------------------------------------------------------------
    // HISTORICAL TRANSACTIONS
    //
    // Imported only from a trusted Admin SDK script. Client apps are
    // read-only and may query only records linked to their Firebase UID.
    // ---------------------------------------------------------------------

    match /historicalTransactions/{transactionId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.get('vendorUid', '') == currentUid()
            || resource.data.get('supplierUid', '') == currentUid()
          )
        );

      allow create, update, delete: if false;
    }

    match /historicalImports/{importId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // REVIEWS
    // ---------------------------------------------------------------------

    match /reviews/{orderId} {
      allow read: if signedIn();

      allow create: if validReviewCreate(orderId);

      allow update: if validReviewEdit(orderId);

      allow delete: if false;

      function validReviewCreate(orderId) {
        let order = get(orderPath(orderId)).data;
        let afterOrder = getAfter(orderPath(orderId)).data;
        let supplierId = order.get('supplierId', '');
        let beforeSupplier = get(supplierPath(supplierId)).data;
        let afterSupplier = getAfter(supplierPath(supplierId)).data;
        let oldCount = beforeSupplier.get('reviews', 0);
        let oldTotal = beforeSupplier.get(
          'ratingTotal',
          beforeSupplier.get('rating', 0) * oldCount
        );
        let newCount = afterSupplier.get('reviews', 0);
        let newTotal = afterSupplier.get('ratingTotal', 0);
        let rating = request.resource.data.get('rating', 0);

        return signedIn()
          && exists(orderPath(orderId))
          && existsAfter(orderPath(orderId))
          && isCompletedOrder(order)
          && order.get('vendorId', '') == currentUid()
          && order.get('reviewSubmitted', false) != true
          && supplierId is string
          && supplierId.size() > 0
          && exists(supplierPath(supplierId))
          && existsAfter(supplierPath(supplierId))
          && request.resource.data.keys().hasOnly([
            'orderId',
            'vendorId',
            'vendorName',
            'supplierId',
            'supplierName',
            'productName',
            'rating',
            'comment',
            'createdAt'
          ])
          && request.resource.data.get('orderId', '') == orderId
          && request.resource.data.get('vendorId', '') == currentUid()
          && request.resource.data.get('vendorName', '')
            == order.get('vendorName', '')
          && request.resource.data.get('supplierId', '') == supplierId
          && request.resource.data.get('supplierName', '')
            == order.get('supplierName', '')
          && request.resource.data.get('productName', '')
            == order.get('productName', '')
          && rating is int
          && rating >= 1
          && rating <= 5
          && request.resource.data.get('comment', '') is string
          && request.resource.data.get('comment', '').size() <= 300
          && request.resource.data.get('createdAt', null) is timestamp
          && afterOrder.get('reviewSubmitted', false) == true
          && afterOrder.get('reviewRating', 0) == rating
          && afterOrder.get('reviewComment', '')
            == request.resource.data.get('comment', '')
          && newCount == oldCount + 1
          && newTotal == oldTotal + rating
          && afterSupplier.get('rating', 0) == newTotal / newCount
          && afterSupplier.get('lastReviewOrderId', '') == orderId;
      }

      function validReviewEdit(orderId) {
        let order = get(orderPath(orderId)).data;
        let afterOrder = getAfter(orderPath(orderId)).data;
        let supplierId = order.get('supplierId', '');
        let beforeSupplier = get(supplierPath(supplierId)).data;
        let afterSupplier = getAfter(supplierPath(supplierId)).data;
        let reviewCount = beforeSupplier.get('reviews', 0);
        let oldTotal = beforeSupplier.get(
          'ratingTotal',
          beforeSupplier.get('rating', 0) * reviewCount
        );
        let newTotal = afterSupplier.get('ratingTotal', 0);
        let rating = request.resource.data.get('rating', 0);

        return signedIn()
          && exists(orderPath(orderId))
          && existsAfter(orderPath(orderId))
          && isCompletedOrder(order)
          && resource.data.get('vendorId', '') == currentUid()
          && order.get('vendorId', '') == currentUid()
          && supplierId is string
          && supplierId.size() > 0
          && exists(supplierPath(supplierId))
          && existsAfter(supplierPath(supplierId))
          && request.resource.data.get('orderId', '') == orderId
          && request.resource.data.get('vendorId', '') == currentUid()
          && request.resource.data.get('supplierId', '') == supplierId
          && rating is int
          && rating >= 1
          && rating <= 5
          && request.resource.data.get('comment', '') is string
          && request.resource.data.get('comment', '').size() <= 300
          && request.resource.data.get('edited', false) == true
          && request.resource.data.get('updatedAt', null) is timestamp
          && changedOnly([
            'rating',
            'comment',
            'edited',
            'updatedAt'
          ])
          && afterOrder.get('reviewSubmitted', false) == true
          && afterOrder.get('reviewRating', 0) == rating
          && afterOrder.get('reviewComment', '')
            == request.resource.data.get('comment', '')
          && afterSupplier.get('reviews', 0) == reviewCount
          && reviewCount > 0
          && newTotal
            == oldTotal - resource.data.get('rating', 0) + rating
          && afterSupplier.get('rating', 0) == newTotal / reviewCount
          && afterSupplier.get('lastReviewOrderId', '') == orderId;
      }
    }

    // ---------------------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if notificationOwnedByCurrentUser(resource.data)
        || isAdmin();

      allow create: if validAdminDecisionNotification()
        || validNewOrderNotification(notificationId)
        || validOrderStatusNotification()
        || validStockAlertNotification();

      allow update: if notificationOwnedByCurrentUser(resource.data)
          && request.resource.data.get('isRead', false) == true
          && request.resource.data.get('readAt', null) is timestamp
          && (
            changedOnly([
              'isRead',
              'readAt'
            ])
            || (
              resource.data.get('type', '') == 'supplier_application_status'
              && resource.data.get('status', '') == 'rejected'
              && request.resource.data.get(
                'rejectionReasonViewedAt',
                null
              ) is timestamp
              && changedOnly([
                'isRead',
                'readAt',
                'rejectionReasonViewedAt'
              ])
            )
          );

      allow delete: if false;

      function validAdminDecisionNotification() {
        let supplierId = request.resource.data.get('supplierId', '');
        let status = request.resource.data.get('status', '');
        let type = request.resource.data.get('type', '');

        return isAdmin()
          && supplierId is string
          && supplierId.size() > 0
          && supplierId != currentUid()
          && request.resource.data.get('userId', '') == supplierId
          && status in ['approved', 'rejected']
          && request.resource.data.get('isRead', true) == false
          && request.resource.data.get('createdAt', null) is timestamp
          && hasNoServerPushFields(request.resource.data)
          && request.resource.data.get('title', '') is string
          && request.resource.data.get('title', '').size() >= 3
          && request.resource.data.get('title', '').size() <= 100
          && request.resource.data.get('message', '') is string
          && request.resource.data.get('message', '').size() >= 3
          && request.resource.data.get('message', '').size() <= 1000
          && (
            (
              type == 'supplier_application_status'
              && request.resource.data.keys().hasOnly([
                'userId',
                'supplierId',
                'title',
                'message',
                'type',
                'status',
                'applicationId',
                'rejectionReason',
                'isRead',
                'createdAt'
              ])
              && request.resource.data.get('applicationId', '')
                == supplierId
              && existsAfter(userPath(supplierId))
              && existsAfter(supplierPath(supplierId))
              && getAfter(userPath(supplierId)).data.get(
                'supplierStatus',
                ''
              ) == status
              && getAfter(supplierPath(supplierId)).data.get('status', '')
                == status
              && (
                (
                  status == 'approved'
                  && request.resource.data.get('title', '')
                    == 'Supplier Application Approved'
                  && request.resource.data.get('message', '')
                    == 'Your supplier application was approved. Supplier tools are now available on your account.'
                )
                || (
                  status == 'rejected'
                  && request.resource.data.get('title', '')
                    == 'Supplier Application Declined'
                  && request.resource.data.get('message', '')
                    == 'Your supplier application was declined. Tap to view the reason.'
                  && request.resource.data.get('rejectionReason', '') is string
                  && request.resource.data.get('rejectionReason', '').size() >= 5
                  && request.resource.data.get('rejectionReason', '').size() <= 500
                  && request.resource.data.get('rejectionReason', '')
                    == getAfter(supplierPath(supplierId)).data.get(
                      'rejectionReason',
                      ''
                    )
                )
              )
            )
            || (
              type == 'supplier_profile_change'
              && request.resource.data.keys().hasOnly([
                'userId',
                'supplierId',
                'title',
                'message',
                'type',
                'status',
                'requestId',
                'changedFields',
                'isRead',
                'createdAt'
              ])
              && request.resource.data.get('requestId', '') == supplierId
              && existsAfter(changeRequestPath(supplierId))
              && getAfter(changeRequestPath(supplierId)).data.get(
                'status',
                ''
              ) == status
              && getAfter(changeRequestPath(supplierId)).data.get(
                'reviewedBy',
                ''
              ) == currentUid()
              && request.resource.data.get('changedFields', [])
                == getAfter(changeRequestPath(supplierId)).data.get(
                  'changedFields',
                  []
                )
              && (
                (
                  status == 'approved'
                  && request.resource.data.get('title', '')
                    == 'Profile Change Approved'
                  && request.resource.data.get('message', '')
                    == 'Your verified supplier business change request was approved and is now visible to vendors.'
                )
                || (
                  status == 'rejected'
                  && request.resource.data.get('title', '')
                    == 'Profile Change Needs Revision'
                  && request.resource.data.get('message', '')
                    == 'Your verified supplier profile change request needs revision. Admin note: '
                      + getAfter(changeRequestPath(supplierId)).data.get(
                        'adminNote',
                        ''
                      )
                )
              )
            )
          );
      }

      function validNewOrderNotification(notificationId) {
        let orderId = request.resource.data.get('orderId', '');
        let afterOrder = getAfter(orderPath(orderId)).data;

        return signedIn()
          && hasNoServerPushFields(request.resource.data)
          && request.resource.data.get('type', '') == 'new_order'
          && orderId is string
          && orderId.size() > 0
          && existsAfter(orderPath(orderId))
          && afterOrder.get('vendorId', '') == currentUid()
          && request.resource.data.get('supplierId', '')
              == afterOrder.get('supplierId', '')
          && request.resource.data.get('userId', '')
              == afterOrder.get('supplierId', '')
          && request.resource.data.get('status', '')
              == afterOrder.get('orderStatus', '')
          && request.resource.data.get('notificationId', '')
              == notificationId
          && afterOrder.get('newOrderNotificationId', '')
              == notificationId;
      }

      function validOrderStatusNotification() {
        let orderId = request.resource.data.get('orderId', '');
        let afterOrder = getAfter(orderPath(orderId)).data;

        return signedIn()
          && hasNoServerPushFields(request.resource.data)
          && request.resource.data.get('type', '') == 'order_status'
          && orderId is string
          && orderId.size() > 0
          && existsAfter(orderPath(orderId))
          && afterOrder.get('supplierId', '') == currentUid()
          && request.resource.data.get('vendorId', '')
              == afterOrder.get('vendorId', '')
          && request.resource.data.get('userId', '')
              == afterOrder.get('vendorId', '')
          && request.resource.data.get('status', '')
              == afterOrder.get('orderStatus', '');
      }

      function validStockAlertNotification() {
        let stockId = request.resource.data.get('stockId', '');
        let sourceOrderId = request.resource.data.get('sourceOrderId', '');
        let afterStock = getAfter(stockPath(stockId)).data;

        return signedIn()
          && hasNoServerPushFields(request.resource.data)
          && request.resource.data.get('type', '') == 'stock_alert'
          && stockId is string
          && stockId.size() > 0
          && existsAfter(stockPath(stockId))
          && request.resource.data.get('supplierId', '')
              == afterStock.get('supplierId', '')
          && request.resource.data.get('userId', '')
              == afterStock.get('supplierId', '')
          && request.resource.data.get('stockStatus', '')
              == afterStock.get('stockStatus', '')
          && (
            (
              currentUid() == afterStock.get('supplierId', '')
              && isApprovedSupplierAccount(currentUid())
            )
            || (
              sourceOrderId is string
              && sourceOrderId.size() > 0
              && existsAfter(orderPath(sourceOrderId))
              && getAfter(orderPath(sourceOrderId)).data.get(
                'vendorId',
                ''
              ) == currentUid()
              && getAfter(orderPath(sourceOrderId)).data.get(
                'supplierId',
                ''
              ) == afterStock.get('supplierId', '')
              && getAfter(orderPath(sourceOrderId)).data.get(
                'stockId',
                ''
              ) == stockId
            )
          );
      }
    }

    // Deny anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
